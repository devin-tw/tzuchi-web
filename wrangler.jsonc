{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tzuchi",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "tzuchi.devin.tw", "custom_domain": true }]
}
